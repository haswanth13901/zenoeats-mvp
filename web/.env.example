# Vite only exposes VITE_-prefixed variables to client code. Everything here is
# public and ends up in the bundle; secrets never belong in it.
VITE_API_BASE=/api/v1
# Customer sign-in (Clerk), for the dev server. Deployed containers take it
# at runtime as CLERK_PUBLISHABLE_KEY instead, so builds carry no key.
# Without it the storefront still works and both operator portals are
# unaffected; only checkout and order tracking say sign-in is unavailable.
VITE_CLERK_PUBLISHABLE_KEY=
