# ---- Platform -----------------------------------------------------------
ENV=development
ROOT_DOMAIN=zenoeats.local
LOG_LEVEL=INFO

# ---- Database -----------------------------------------------------------
# These hostnames resolve inside the Docker network only.
# Running the API natively on your host instead? Use:
#   @127.0.0.1:5433   (the port docker-compose publishes)
# and swap redis-broker for 127.0.0.1 below.
POSTGRES_PASSWORD=postgres_dev_pw
DATABASE_URL_APP=postgresql+psycopg2://zenoeats_app:app_dev_pw@postgres:5432/zenoeats
DATABASE_URL_SYSTEM=postgresql+psycopg2://zenoeats_system:system_dev_pw@postgres:5432/zenoeats
DATABASE_URL_MIGRATE=postgresql+psycopg2://zenoeats_migrate:migrate_dev_pw@postgres:5432/zenoeats

# ---- Redis / Celery -----------------------------------------------------
CELERY_BROKER_URL=redis://redis-broker:6379/0
CELERY_RESULT_BACKEND=redis://redis-broker:6379/1

# ---- Clerk --------------------------------------------------------------
# One Clerk instance on the PARENT domain so the session cookie is scoped to
# .zenoeats.com and works across every restaurant subdomain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_replace_me
# Local development only. Startup refuses to boot with this on in production.
AUTH_DEV_BYPASS=false

# ---- Stripe -------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# From the CONNECT webhook endpoint, not the platform one. They are separate
# endpoints with separate secrets.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me

# ---- Crypto -------------------------------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace_me_with_a_real_fernet_key

# ---- Frontend -----------------------------------------------------------
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_ROOT_DOMAIN=zenoeats.local

# ---- Policy -------------------------------------------------------------
PENDING_PAYMENT_TTL_MINUTES=30
IDEMPOTENCY_TTL_HOURS=24

# Cache and rate limiting (separate instance from the Celery broker).
REDIS_RUNTIME_URL=redis://127.0.0.1:6380/0

# ---- Container topology -------------------------------------------------
# The same services reached from inside the compose network rather than from
# the host. docker-compose.yml maps these onto the real variable names for
# the api, worker and beat services; a native run ignores them and uses the
# published-port URLs above. Two topologies, one file, no duplicated secrets.
DOCKER_DATABASE_URL_APP=postgresql+psycopg2://zenoeats_app:app_dev_pw@postgres:5432/zenoeats
DOCKER_DATABASE_URL_SYSTEM=postgresql+psycopg2://zenoeats_system:system_dev_pw@postgres:5432/zenoeats
DOCKER_DATABASE_URL_MIGRATE=postgresql+psycopg2://zenoeats_migrate:migrate_dev_pw@postgres:5432/zenoeats
DOCKER_CELERY_BROKER_URL=redis://redis-broker:6379/0
DOCKER_CELERY_RESULT_BACKEND=redis://redis-broker:6379/1
DOCKER_REDIS_RUNTIME_URL=redis://redis-runtime:6379/0

# ---- Platform administrators --------------------------------------------
# Who can sign in to the super admin portal at admin.<ROOT_DOMAIN>.
#
# SET OR CHANGE A PASSWORD
#   cd backend
#   ../.venv/Scripts/python.exe scripts/hash_password.py you@example.com --write
#
#   Prompts twice, echoes nothing, and rewrites the ADMIN_USERS line below.
#   Minimum 12 characters. Restart the API for it to take effect.
#
# ADD ANOTHER ADMIN, KEEPING THE EXISTING ONES
#   ../.venv/Scripts/python.exe scripts/hash_password.py ops@example.com --add
#
# PRINT THE ENTRY INSTEAD OF WRITING IT
#   ../.venv/Scripts/python.exe scripts/hash_password.py you@example.com
#
# REMOVE AN ADMIN
#   Delete their "email:hash" entry from the line below. It takes effect at
#   their very next request -- every request re-reads this list, so access
#   ends immediately rather than whenever their session would have expired.
#
# FORMAT
#   email:hash, with several admins separated by ";" -- not "," because an
#   argon2 hash contains commas of its own (m=65536,t=3,p=4). The hash is
#   base64 encoded because a raw argon2 hash contains "$", which docker
#   compose expands as a variable reference and silently replaces with an
#   empty string, corrupting the credential inside containers only.
#
# The password itself is never stored, here or anywhere else -- only a hash,
# which cannot be reversed. If you forget it, generate a new one; it cannot
# be recovered.
#
# Admins are named individually rather than sharing one login so that
# platform_audit_logs records which operator suspended a restaurant or
# exported revenue. One shared account would make that column meaningless.
#
# Leave empty in this file: .env.example is committed, so a real hash here
# would be published in the repository.
ADMIN_USERS=
#
# Signs the super admin and restaurant staff session cookies. Generate once:
#   openssl rand -base64 32
# Rotating it immediately signs out every admin and every restaurant user.
SESSION_SECRET=
#
# Session lifetimes, in minutes.
#   Admin  8 hours: an operator session on a workstation.
#   Staff 12 hours: long enough to outlast a shift on a kitchen tablet,
#                   short enough that a device left on the counter overnight
#                   is not still signed in.
ADMIN_SESSION_TTL_MINUTES=480
STAFF_SESSION_TTL_MINUTES=720
